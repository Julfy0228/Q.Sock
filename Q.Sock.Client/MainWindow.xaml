<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Q.Sock.Client.Converters"
        x:Class="Q.Sock.Client.MainWindow"
        Title="Q.Sock"
        Width="1000"
        Height="650"
        MinWidth="560"
        MinHeight="420"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <converters:FirstLetterConverter x:Key="FirstLetterConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="{DynamicResource PanelBackgroundBrush}" Height="48">
            <TextBlock Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Margin="16,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Не подключено" />
            <Button Name="ToggleOnlineButton"
                    Grid.Column="1"
                    Content="Онлайн"
                    Click="ToggleOnlineButton_Click" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <Grid Grid.Row="0" RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" Padding="16">
                        <ItemsControl Name="MessagesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="48,*" Margin="0,8,0,0">
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Ellipse Width="40" Height="40" Fill="{DynamicResource AvatarBrush}" />
                                            <TextBlock Text="{Binding SenderName, Converter={StaticResource FirstLetterConverter}}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource OnAccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SenderName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="15" />
                                                <TextBlock Text="{Binding SentAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <SelectableTextBlock Text="{Binding Text}"
                                                                 TextWrapping="Wrap"
                                                                 Foreground="{DynamicResource MessageTextBrush}"
                                                                 FontSize="15"
                                                                 Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1" Margin="16" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="12,8">
                            <TextBox Name="MessageTextBox"
                                     PlaceholderText="Напишите сообщение..."
                                     IsEnabled="False"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     KeyDown="MessageTextBox_KeyDown" />
                            <Button Name="SendButton"
                                    Grid.Column="1"
                                    Classes="primary"
                                    Content="→"
                                    FontSize="20"
                                    IsEnabled="False"
                                    Width="40"
                                    Height="32"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Padding="0"
                                    Click="SendButton_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource ProfileBackgroundBrush}" Height="56">
                    <Button Name="ProfileButton"
                            Background="Transparent"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Width="280"
                            Padding="8"
                            Click="ToggleAccountsButton_Click">
                        <Grid ColumnDefinitions="40,*,Auto" VerticalAlignment="Center">
                            <Grid Width="36" Height="36">
                                <Ellipse Width="36" Height="36" Fill="{DynamicResource AvatarBrush}" />
                                <TextBlock Name="CurrentUserInitial"
                                           Text="?"
                                           FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Name="CurrentUserName"
                                           Text="Не подключено"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Name="CurrentUserStatus"
                                           Text="Оффлайн"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="⋯"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Margin="8,0" />
                        </Grid>
                    </Button>
                </Border>

                <Border Name="AccountsPopup"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8,0,0,8"
                        Width="300"
                        MaxHeight="440"
                        Padding="10"
                        Background="{DynamicResource PopupBackgroundBrush}"
                        CornerRadius="8"
                        BoxShadow="{DynamicResource PopupShadow}"
                        IsVisible="False"
                        ZIndex="20">
                    <StackPanel Spacing="6">
                        <Grid Margin="6,0,2,2">
                            <TextBlock Text="Аккаунты"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer MaxHeight="250">
                            <ItemsControl Name="AccountsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <Button Content="{Binding UserName}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="SwitchAccountButton_Click" />
                                            <Button Grid.Column="1"
                                                    Content="Удалить"
                                                    Classes="danger"
                                                    Margin="4,0,0,0"
                                                    ToolTip.Tip="Удалить из сохранённых"
                                                    Click="RemoveSavedAccountButton_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Separator Background="{DynamicResource SeparatorBrush}" Margin="0,2" />
                        <Button Content="Добавить аккаунт"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="ShowLoginPanel_Click" />
                        <Button Name="LogoutButton"
                                Content="Выйти из аккаунта"
                            Classes="danger"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="LogoutButton_Click" />
                    </StackPanel>
                </Border>

                <Border Name="LoginPanel"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8,0,0,8"
                        Width="300"
                        Padding="16"
                        Background="{DynamicResource PopupBackgroundBrush}"
                        CornerRadius="8"
                        BoxShadow="{DynamicResource PopupShadow}"
                        IsVisible="False"
                        ZIndex="21">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Добавить аккаунт"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Логин" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Name="UserNameTextBox" PlaceholderText="Например, Julfy" />
                        <TextBlock Text="Пароль" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBox Name="PasswordTextBox" PasswordChar="●" PlaceholderText="Минимум 4 символа" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Name="LoginButton" Classes="primary" Content="Войти" Click="LoginButton_Click" />
                            <Button Name="RegisterButton" Grid.Column="1" Content="Создать" Click="RegisterButton_Click" />
                        </Grid>
                        <Button Content="Отмена" Click="HideLoginPanel_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Name="OnlinePanel" Grid.Column="1" Width="200" Background="{DynamicResource PanelBackgroundBrush}">
                <StackPanel Margin="16">
                    <TextBlock Text="Онлайн"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,0,0,8" />
                    <ItemsControl Name="UsersItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                    <Grid Width="32" Height="32">
                                        <Ellipse Width="32" Height="32" Fill="{DynamicResource AvatarBrush}" />
                                        <TextBlock Text="{Binding UserName, Converter={StaticResource FirstLetterConverter}}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource OnAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding UserName}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
<Window x:Class="Q.Sock.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Q.Sock" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель входа / подключения -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Логин:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="UsernameTextBox" Width="150" Margin="0,0,10,0" Text="User1"/>
            <TextBlock Text="Пароль:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <PasswordBox x:Name="PasswordTextBox" Width="120" Margin="0,0,10,0"/>
            <Button x:Name="ConnectButton" Content="Войти" Width="90" Click="ConnectButton_Click"/>
            <Button x:Name="RegisterButton" Content="Регистрация" Width="110" Click="RegisterButton_Click" Margin="0,0,10,0"/>
            <TextBlock x:Name="StatusTextBlock" Text="Не подключено" Foreground="Red" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Основная область: Чат и Список пользователей -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- История сообщений -->
            <ListBox x:Name="MessagesListBox" DisplayMemberPath="DisplayText" Margin="0,0,10,0"/>

            <!-- Список пользователей онлайн -->
            <DockPanel Grid.Column="1">
                <TextBlock Text="Онлайн:" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox x:Name="UsersListBox" DisplayMemberPath="Name"/>
            </DockPanel>
        </Grid>

        <!-- Панель отправки сообщения -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageTextBox" Grid.Column="0" Margin="0,0,10,0" KeyDown="MessageTextBox_KeyDown" IsEnabled="False"/>
            <Button x:Name="SendButton" Content="Отправить" Grid.Column="1" Click="SendButton_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
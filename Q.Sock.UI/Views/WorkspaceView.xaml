<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Q.Sock.UI.Views.WorkspaceView"
    Design.Width="1280"
    Design.Height="820"
    Background="{DynamicResource background}"
>
    <Grid RowDefinitions="*,Auto">
        <Grid x:Name="WorkspaceGrid" ColumnDefinitions="72,280,*,0">
            <Border x:Name="RailPanel" Background="{DynamicResource chrome}">
                <ScrollViewer>
                    <StackPanel x:Name="RailItemsPanel" Spacing="16" Margin="12,14" />
                </ScrollViewer>
            </Border>
            <Border x:Name="SidebarPanel" Grid.Column="1" Background="{DynamicResource panel}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="12,12,12,4">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="SidebarTitleText"
                                IsVisible="False"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource text}"
                            />
                            <Border
                                x:Name="SearchSurface"
                                Padding="8,0"
                                CornerRadius="8"
                                Background="{DynamicResource surface}"
                            >
                                <Grid ColumnDefinitions="32,*">
                                    <ContentControl
                                        x:Name="SearchIconHost"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBox
                                        x:Name="SearchInput"
                                        Grid.Column="1"
                                        Classes="search"
                                        PlaceholderText="Поиск людей и сообщений"
                                    />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <ContentControl x:Name="SidebarActionsHost" Grid.Column="1" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="12,2,12,4" IsVisible="False"
                               FontSize="11" LineHeight="16.8" TextWrapping="Wrap"
                               Foreground="{DynamicResource muted}" />
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavigationPanel" Spacing="4" Margin="12,8" />
                    </ScrollViewer>
                </Grid>
            </Border>
            <Grid x:Name="ConversationPanel" Grid.Column="2" />
            <Border x:Name="MembersPanel" Grid.Column="3" Background="{DynamicResource panel}">
                <ScrollViewer>
                    <StackPanel x:Name="MemberListPanel" Spacing="8" Margin="12" />
                </ScrollViewer>
            </Border>
        </Grid>
        <Border x:Name="BottomBar" Grid.Row="1" Padding="4,4" Background="{DynamicResource chrome}">
            <Grid x:Name="BottomNavigationGrid" ColumnDefinitions="*,*,*,*" />
        </Border>
    </Grid>
</UserControl>

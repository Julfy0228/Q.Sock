<Viewbox
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Q.Sock.UI.Views.LogoMark"
    Stretch="Uniform"
>
    <Panel Width="100" Height="100">
        <Ellipse Margin="3" Fill="{DynamicResource accent}" />
        <Path
            Data="M49,25 A24,24 0 1 1 49,73 A24,24 0 1 1 49,25 Z M65,66 L73,75"
            Stroke="{DynamicResource text}"
            StrokeThickness="10.5"
            StrokeLineCap="Round"
        />
    </Panel>
</Viewbox>

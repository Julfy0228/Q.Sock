<Project>
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.WebAssembly" />
    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
        <WasmBuildNative>true</WasmBuildNative>
        <PublishTrimmed>false</PublishTrimmed>
        <WasmLinkIcalls>false</WasmLinkIcalls>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <ProjectReference Include="../Q.Sock.UI/Q.Sock.UI.csproj" />
    </ItemGroup>
    <ItemGroup>
        <TrimmerRootAssembly Include="Q.Sock.Core" />
        <TrimmerRootAssembly Include="Q.Sock.Shared" />
        <TrimmerRootAssembly Include="Q.Sock.UI" />
        <TrimmerRootAssembly Include="Q.Sock.Browser" />
        <TrimmerRootAssembly Include="Q.Sock.PluginContracts" />
        <TrimmerRootAssembly Include="Avalonia.Controls" />
        <TrimmerRootAssembly Include="Avalonia.Base" />
        <TrimmerRootAssembly Include="Avalonia.Markup.Xaml" />
        <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    </ItemGroup>
    <ItemGroup>
        <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.WebAssembly" />
    <Target Name="CopyAvaloniaBrowserAssets" AfterTargets="Build">
        <ItemGroup>
            <AvaloniaBrowserAsset Include="$(NuGetPackageRoot)avalonia.browser/12.1.3/staticwebassets/*.js" />
        </ItemGroup>
        <Copy
            SourceFiles="@(AvaloniaBrowserAsset)"
            DestinationFolder="$(TargetDir)wwwroot/_framework"
        />
    </Target>
    <Import
        Project="../build/InProcessWasmTasks.targets"
        Condition="'$(QsockUseInProcessWasmTasks)' == 'true' and '$(_WebAssemblySdkTasksAssembly)' != ''"
    />
    <Target Name="CopyPublishedAvaloniaBrowserAssets" AfterTargets="Publish">
        <ItemGroup>
            <PublishedAvaloniaAsset Include="$(NuGetPackageRoot)avalonia.browser/12.1.3/staticwebassets/*.js" />
        </ItemGroup>
        <Copy
            SourceFiles="@(PublishedAvaloniaAsset)"
            DestinationFolder="$(PublishDir)wwwroot/_framework"
        />
    </Target>
</Project>
